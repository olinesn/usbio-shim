# Avisoft UltraSoundGate xx16H units (Cypress vendor id 0547; the 1216H is 0547:1012):
# let users in the plugdev group open them with libusb (usbio-helper). Install once with sudo:
#   sudo cp 99-avisoft-ultrasoundgate.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger
# then unplug and replug the units. Check: ls -l /dev/bus/usb/*/* shows group plugdev, mode 0664.
SUBSYSTEM=="usb", ATTRS{idVendor}=="0547", ATTRS{idProduct}=="0412|0512|0612|0712|0812|0912|1012|1112|1212|1312|1412", MODE="0664", GROUP="plugdev"
